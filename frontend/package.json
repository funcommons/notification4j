{
  "name": "ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint \"src/**/*.vue\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:regression": "playwright test --project=regression-desktop --project=regression-tablet --project=regression-mobile",
    "verify": "vue-tsc -b --noEmit && eslint \"src/**/*.vue\" && vitest run"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "altcha": "^3.2.1",
    "axios": "^1.13.6",
    "crypto-js": "^4.2.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.13.3",
    "fabric": "^6.7.0",
    "jszip": "^3.10.1",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "remixicon": "^4.9.1",
    "sass": "^1.97.3",
    "three": "^0.169.0",
    "uuid": "^14.0.1",
    "vue": "^3.5.25",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^9.14.4",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@popperjs/core": "^2.11.8",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.169.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "puppeteer-core": "^25.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "unplugin-auto-import": "^19.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.1.5"
  }
}
